{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://13.204.197.82/api/:path*" },
    { "source": "/actuator/:path*", "destination": "http://13.204.197.82/actuator/:path*" },
    { "source": "/staff/:path*", "destination": "http://13.204.197.82/staff/:path*" },
    { "source": "/staff", "destination": "http://13.204.197.82/staff/login" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}