# Copy to .env for local running. Never commit real values.
DATABASE_URL=jdbc:postgresql://localhost:5432/jamunaconnect
DATABASE_USERNAME=jamuna
DATABASE_PASSWORD=change-me
OFFICE_EMAIL=jamuna-office@example.iitm.ac.in
ESCALATION_EMAIL=jamunagensec@example.iitm.ac.in
# Leave blank to run in in-app-queue mode (mail is notification-only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Prod staff login is seeded/updated from these BCrypt hashes on startup.
# Generate with: htpasswd -bnBC 12 "" 'new-password' | tr -d ':\n' | sed 's/^//'
STAFF_OFFICE_USERNAME=office
STAFF_OFFICE_PASSWORD_HASH=
STAFF_OFFICE_DISPLAY_NAME=Hostel Office
STAFF_WARDEN_USERNAME=warden
STAFF_WARDEN_PASSWORD_HASH=
STAFF_WARDEN_DISPLAY_NAME=Warden
# Set true behind HTTPS; keep false for plain local HTTP.
SESSION_COOKIE_SECURE=false
